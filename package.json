{
  "name": "mth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --parallel --filter portfolio --filter blog dev",
    "dev:portfolio": "pnpm --filter portfolio dev",
    "dev:blog": "pnpm --filter blog dev",
    "build": "pnpm -r build",
    "build:portfolio": "pnpm --filter portfolio build",
    "build:blog": "pnpm --filter blog build",
    "preview": "pnpm --parallel --filter portfolio --filter blog preview",
    "preview:portfolio": "pnpm --filter portfolio preview",
    "preview:blog": "pnpm --filter blog preview",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
